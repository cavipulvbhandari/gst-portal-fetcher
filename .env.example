# Copy to .env and adjust. Do NOT commit .env.
# The GSTIN of the single client you are fetching.
GSTFETCH_GSTIN=27AAACX1234F1Z5

# Earliest GST return period to fetch from, as MMYYYY (e.g. 072017 for Jul-2017,
# the GST go-live month). The tool fetches every period from here to the
# current open period.
GSTFETCH_START_PERIOD=072017

# Where fetched data and checkpoints are written.
GSTFETCH_DATA_DIR=./data

# Playwright session-state file produced by `gstfetch login`.
GSTFETCH_SESSION_FILE=./session_state.json

# Polite delay (seconds) between portal API calls.
GSTFETCH_REQUEST_DELAY=1.5

# Run the login browser headed (true) so you can solve the CAPTCHA/OTP.
GSTFETCH_HEADED=true


# ---------------------------------------------------------------------------
# Microvista Notice Alert portal (separate tool: `microvista`)
# ---------------------------------------------------------------------------
# Login credentials for https://noticealert.microvistatech.com
# Leave blank to log in by hand in the opened browser window.
MICROVISTA_EMAIL=
MICROVISTA_PASSWORD=

# Where downloaded notice PDFs and per-client manifests are written.
MICROVISTA_DATA_DIR=./data/microvista

# Reusable authenticated browser session produced by `microvista login`.
MICROVISTA_SESSION_FILE=./microvista_session.json

# Optional comma-separated GSTIN filter. Empty = every client on the portal.
MICROVISTA_GSTINS=

# Run the browser visibly (recommended for the first runs).
MICROVISTA_HEADED=true

# Polite delay (seconds) between page actions.
MICROVISTA_REQUEST_DELAY=1.0
